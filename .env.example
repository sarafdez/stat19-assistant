# Copy to .env and fill in. `node setup.mjs` writes the API key for you.
# .env is git-ignored — never commit it.

# ── Required for the chat ───────────────────────────────────────────────────────
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Everything below is OPTIONAL ───────────────────────────────────────────────
# The FHI locations below are the built-in defaults — setup.mjs works without setting them.
# Uncomment only to point somewhere else.
#
# Git remote of the Stat19 wiki (an Azure DevOps wiki repo):
# STAT19_WIKI_REMOTE=https://fhi.visualstudio.com/DefaultCollection/Stat19/_git/Stat19.wiki
#
# Root URL of the dbt docs site (serves manifest.json and catalog.json):
# STAT19_DBT_BASE=https://dataproducts.stat19.fhi.no

# Where the snapshots are stored locally.
# Default: ./Stat19.wiki and ./dbt inside this repo. Point them somewhere else if the
# files are shared through OneDrive, a network drive or an external disk. Absolute paths,
# paths relative to this repo, and a leading ~ all work.
# STAT19_WIKI_DIR=~/OneDrive/stat19/Stat19.wiki
# STAT19_DBT_DIR=~/OneDrive/stat19/dbt_docs

# API port (the client dev server is always 5178).
# PORT=5179
